# Copy to .env.local and fill in. Never commit .env.local.

# Supabase: Project Settings → API (make sure it's the Stryvv project)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Service role: no code uses it today. Server-only if it's ever needed again.
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI: voice transcription (gpt-transcribe). Server-only. A restricted key in its own project with a budget.
OPENAI_API_KEY=
# The onboarding coach (Claude). Server-only.
ANTHROPIC_API_KEY=

# Resend: transactional email (unused until the new emails are built)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
