# Copy to .env.local and fill in. Never commit .env.local.

# Supabase: Project Settings → API (make sure it's the Stryvv project)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Service role: no code uses it today. Server-only if it's ever needed again.
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI: the AI coach (unused until the new coach is built)
OPENAI_API_KEY=

# Resend: transactional email (unused until the new emails are built)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
